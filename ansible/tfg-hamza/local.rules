# ======================================================
# REGLAS PERSONALIZADAS - SecureOps TFG
# ======================================================

# 1. Deteccion de escaneo de puertos (Nmap SYN)
alert tcp any any -> $HOME_NET any (msg:"SECUREOPS: Posible escaneo de puertos Nmap SYN"; flags:S; threshold:type both, track by_src, count 20, seconds 10; sid:1000001; rev:1;)

# 2. Deteccion de fuerza bruta SSH
alert tcp any any -> $HOME_NET 22 (msg:"SECUREOPS: Posible fuerza bruta SSH"; flow:to_server,established; threshold:type both, track by_src, count 5, seconds 60; sid:1000002; rev:1;)

# 3. Acceso HTTP externo detectado
alert tcp $EXTERNAL_NET any -> $HOME_NET 80 (msg:"SECUREOPS: Acceso HTTP externo detectado"; flow:to_server,established; sid:1000003; rev:1;)

# 4. Acceso HTTPS externo detectado
alert tcp $EXTERNAL_NET any -> $HOME_NET 443 (msg:"SECUREOPS: Acceso HTTPS externo detectado"; flow:to_server,established; sid:1000004; rev:1;)

# 5. Acceso FTP detectado
alert tcp any any -> $HOME_NET 21 (msg:"SECUREOPS: Acceso FTP detectado"; flow:to_server,established; sid:1000005; rev:1;)

# 6. Acceso Telnet detectado (protocolo inseguro)
alert tcp any any -> $HOME_NET 23 (msg:"SECUREOPS: Acceso Telnet detectado - protocolo inseguro"; flow:to_server,established; sid:1000006; rev:1;)

# 7. Posible transferencia de zona DNS (AXFR)
alert tcp any any -> $HOME_NET 53 (msg:"SECUREOPS: Posible transferencia de zona DNS (AXFR)"; flow:to_server,established; content:"|00 00 FC|"; sid:1000007; rev:1;)

# 8. Posible ping flood (ICMP excesivo)
alert icmp any any -> $HOME_NET any (msg:"SECUREOPS: Posible ping flood"; itype:8; threshold:type threshold, track by_src, count 50, seconds 10; sid:1000008; rev:2;)
# 9. Intento de acceso a panel de administracion
alert http any any -> $HOME_NET any (msg:"SECUREOPS: Intento de acceso a panel de administracion"; flow:to_server,established; content:"/admin"; http_uri; nocase; sid:1000009; rev:1;)

# 10. Posible SQL Injection
alert http any any -> $HOME_NET any (msg:"SECUREOPS: Posible SQL Injection"; flow:to_server,established; content:"UNION"; http_uri; nocase; sid:1000010; rev:1;)

# 11. Posible reverse shell
alert tcp $HOME_NET any -> $EXTERNAL_NET any (msg:"SECUREOPS: Posible reverse shell - conexion saliente sospechosa"; flow:from_client,established; content:"/bin/sh"; sid:1000011; rev:1;)
